# VX API Gateway — configuration reference.
#
# Copy to .env and fill in. Real .env files are gitignored: this repository is
# public, and secrets do not belong in it.
#
#   cp .env.example .env
#
# Every value here is a placeholder. Generate real secrets, do not edit these.

# ─────────────────────────────────────────────────────────────────────────────
# Listener
# ─────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=:9777

# ─────────────────────────────────────────────────────────────────────────────
# Routing
#
# The gateway matches on Host *and* path, so one instance can front any number
# of unrelated domains, each with its own upstreams on any ports. Nothing is
# restricted to a fixed list of service names or localhost ports.
#
# Three ways to declare routes, in precedence order. SERVICE_ROUTES and the
# ROUTE_* variables are additive, so a JSON baseline can be extended per
# deployment.
# ─────────────────────────────────────────────────────────────────────────────

# 1. SERVICE_ROUTES — a JSON array. The most expressive form.
#
#    host          "" = any domain · "api.example.com" = exact
#                  "*.example.com" = any subdomain (not the apex)
#    prefix        path prefix, matched on segment boundaries ("/api/v1" does
#                  not match "/api/v11"). "/" matches everything on that host.
#    target_url    a single upstream
#    targets       several upstreams, load-balanced by LOAD_BALANCING_ALGO.
#                  Accepts "host:port", "host", or a full URL — a bare
#                  "host:port" is treated as http://host:port.
#    weights       positional against targets, for the "weighted" algorithm
#    strip_prefix  remove the prefix before forwarding
#    require_auth  demand a valid JWT or API key
#    health_path   probe with an HTTP GET instead of a bare TCP dial; anything
#                  below 500 counts as healthy. Strongly recommended: a
#                  listening socket in front of a wedged app looks fine to a dial.
#    preserve_host forward the client's Host header instead of rewriting it to
#                  the upstream's. Needed when the upstream serves virtual hosts.
#    timeout_secs  per-route upstream timeout
#
# SERVICE_ROUTES=[{"name":"api","host":"api.example.com","prefix":"/","targets":["10.0.0.11:8080","10.0.0.12:8080"],"health_path":"/healthz","strip_prefix":false,"timeout_secs":30},{"name":"web","host":"*.example.com","prefix":"/","target_url":"https://origin.internal","preserve_host":true}]

# 2. ROUTE_<NAME>_* — one group per route. <NAME> is anything you choose; it is
#    not matched against a built-in list. A route needs at least a _URL or
#    _TARGETS, otherwise it is skipped with a warning.
#
# ROUTE_BILLING_HOST=billing.example.com
# ROUTE_BILLING_PREFIX=/v2
# ROUTE_BILLING_TARGETS=10.0.0.7:8080,https://billing-2.internal
# ROUTE_BILLING_WEIGHTS=3,1
# ROUTE_BILLING_HEALTH_PATH=/healthz
# ROUTE_BILLING_STRIP_PREFIX=true
# ROUTE_BILLING_REQUIRE_AUTH=true
# ROUTE_BILLING_PRESERVE_HOST=false
# ROUTE_BILLING_TIMEOUT_SECS=30

# 3. The VxCloud localhost topology (nine fixed ports). Opt-in, and off by
#    default — it used to be registered unconditionally on every boot.
ENABLE_VXCLOUD_DEFAULT_ROUTES=false

# round-robin | least-conn | ip-hash | weighted
LOAD_BALANCING_ALGO=least-conn

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — generate these, never reuse the placeholders
#   JWT_SECRET:       openssl rand -base64 48
#   GRAFANA_PASSWORD: openssl rand -base64 24
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-openssl-rand-base64-48
GRAFANA_PASSWORD=replace-me-openssl-rand-base64-24

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting and DDoS
# ─────────────────────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_SECOND=100
MAX_BURST_SIZE=200
DDOS_THRESHOLD=1000
BLOCK_DURATION=10m

# ─────────────────────────────────────────────────────────────────────────────
# Upstream behaviour
# ─────────────────────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=10s
CONNECTION_TIMEOUT=30s
MAX_IDLE_CONNS=100
IDLE_CONN_TIMEOUT=90s
CIRCUIT_BREAKER_MAX=5
CIRCUIT_BREAKER_TIMEOUT=30s

# ─────────────────────────────────────────────────────────────────────────────
# Caching, CORS, observability
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=5m
REDIS_ADDR=localhost:6379
CORS_ALLOWED_ORIGINS=["*"]
LOG_LEVEL=info
