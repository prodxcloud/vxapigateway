# .env file for development
GATEWAY_PORT=:8080
JWT_SECRET=dev-secret-key-change-in-production-123456
MAX_REQUESTS_PER_SECOND=100
MAX_BURST_SIZE=200
DDOS_THRESHOLD=1000
REDIS_ADDR=localhost:6379
LOAD_BALANCING_ALGO=least-conn
ENABLE_CACHING=true
CACHE_TTL=5m
CORS_ALLOWED_ORIGINS=["*"]
GRAFANA_PASSWORD=admin

# Service Routes (local development)
SERVICE_INFINITY_URL=http://localhost:8000
SERVICE_LLM_URL=http://localhost:8745
SERVICE_STUDIO_URL=http://localhost:8000
SERVICE_ADMIN_URL=http://localhost:8742
