# Go tooling assumes LF: gofmt reports every CRLF file as unformatted, so a
# Windows checkout otherwise fails `gofmt -l` on files nobody edited.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# Compiled output, in case a stale artifact is ever staged again: `text=auto`
# detects binary content and leaves it alone, but saying so explicitly means a
# checkout can never rewrite bytes inside an executable.
gateway               binary
va_api_gateway_golang binary
*.exe                 binary
*.so                  binary
*.a                   binary
