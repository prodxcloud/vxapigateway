# =============================================================
# VA API Gateway Configuration
# =============================================================

# Gateway listening port
GATEWAY_PORT=:9777

# Rate limiting
MAX_REQUESTS_PER_SECOND=100
MAX_BURST_SIZE=200
DDOS_THRESHOLD=1000
BLOCK_DURATION=10m

# JWT (change in production!)
JWT_SECRET=your-secret-key-change-in-production

# Health checks & connections
HEALTH_CHECK_INTERVAL=10s
CONNECTION_TIMEOUT=30s
MAX_IDLE_CONNS=100
IDLE_CONN_TIMEOUT=90s

# Circuit breaker
CIRCUIT_BREAKER_MAX=5
CIRCUIT_BREAKER_TIMEOUT=30s

# Compression & caching
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_TTL=5m

# Redis
REDIS_ADDR=localhost:6379

# Load balancing: round-robin | least-conn | ip-hash | weighted
LOAD_BALANCING_ALGO=least-conn

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---- Service Routes (JSON array) ----
SERVICE_ROUTES=[{"prefix":"/api/studio","target_url":"http://localhost:3000","strip_prefix":true,"require_auth":false,"weight":1,"timeout_secs":30},{"prefix":"/api/studio2","target_url":"http://localhost:3001","strip_prefix":true,"require_auth":false,"weight":1,"timeout_secs":30},{"prefix":"/api/ai","target_url":"http://localhost:8741","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":60},{"prefix":"/api/admin","target_url":"http://localhost:8242","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":30},{"prefix":"/api/core","target_url":"http://localhost:8743","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":30},{"prefix":"/api/node","target_url":"http://localhost:8744","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":30},{"prefix":"/api/llm","target_url":"http://localhost:8745","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":120},{"prefix":"/api/llm2","target_url":"http://localhost:8746","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":120},{"prefix":"/api/agent","target_url":"http://localhost:8788","strip_prefix":true,"require_auth":true,"weight":1,"timeout_secs":120}]
